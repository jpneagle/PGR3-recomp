+
+// Runs on the worker right before a client renders a frame, so the title gets
+// exactly one frame of music per frame it mixes.
+void AudioSystem::PumpMusicCapture() {
+  uint32_t callback = music_capture_callback_;
+  if (!callback) {
+    return;
+  }
+  constexpr uint32_t kSamples = MediaPlayer::kFrameSamples * MediaPlayer::kChannels;
+  float frame[kSamples];
+  if (!media_player_->ReadFrame(frame)) {
+    return;
+  }
+  if (!music_capture_buffers_) {
+    music_capture_buffers_ =
+        memory()->SystemHeapAlloc(kMusicCaptureBuffers * kSamples * sizeof(float));
+  }
+  uint32_t buffer = music_capture_buffers_ + music_capture_index_ * kSamples * sizeof(float);
+  music_capture_index_ = (music_capture_index_ + 1) % kMusicCaptureBuffers;
+  auto* dest = memory()->TranslateVirtual<rex::be<float>*>(buffer);
+  for (uint32_t i = 0; i < kSamples; ++i) {
+    dest[i] = frame[i];
+  }
+  uint64_t args[] = {buffer, music_capture_context_.load()};
+  function_dispatcher_->Execute(worker_thread_->thread_state(), callback, args,
+                                rex::countof(args));
+}
