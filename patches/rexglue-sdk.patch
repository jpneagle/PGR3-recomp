+  if (data.empty()) {
+    REXKRNL_WARN("XMP: cannot read song {}", path);
+  } else {
+    REXKRNL_INFO("XMP: playing {}", path);
+  }
+
+  if (auto* player = GetMediaPlayer(kernel_state_)) {
+    player->SetVolume(volume_);
+    player->Play(std::move(data), [this, play_id] { OnSongFinished(play_id); });
