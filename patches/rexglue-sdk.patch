+
+bool XmpApp::AdvanceSong() {
+  size_t count = active_playlist_->songs.size();
+  size_t remaining = 0;
+  for (size_t i = 0; i < count; ++i) {
+    remaining += played_[i] ? 0 : 1;
+  }
+  if (!remaining) {
+    if (repeat_mode_ == RepeatMode::kNoRepeat) {
+      return false;
+    }
+    played_.assign(count, false);
+    remaining = count;
+  }
+  if (playback_mode_ == PlaybackMode::kShuffle) {
+    size_t pick = size_t(std::rand()) % remaining;
+    for (size_t i = 0; i < count; ++i) {
+      if (!played_[i] && pick-- == 0) {
+        active_song_index_ = int(i);
+        break;
+      }
+    }
+  } else {
+    active_song_index_ = int((size_t(active_song_index_) + 1) % count);
+  }
+  return true;
+}
