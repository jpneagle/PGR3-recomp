+/**
+ * @file        audio/media_player.h
+ * @brief       WMA/MP3 playback for the XMP (Xbox Music Player) title playlists
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the root for more details.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+struct SDL_AudioStream;
+
+namespace rex::audio {
+
+// Decodes one song at a time on its own thread. The output is 48 kHz stereo
+// float and goes either to the host audio device or, when a title captures
+// the XMP output (XMPCaptureOutput), to ReadFrame() in XAudio-sized frames.
+class MediaPlayer {
+ public:
+  static constexpr uint32_t kSampleRate = 48000;
+  static constexpr uint32_t kChannels = 2;
+  static constexpr uint32_t kFrameSamples = 256;  // one XAudio render frame
+
+  MediaPlayer();
+  ~MediaPlayer();
+
+  // Starts decoding `data` (a whole WMA/MP3 file), replacing the current song.
+  // `on_finished` runs on the decoder thread once the song has played out; it
+  // may call Play() again.
+  void Play(std::vector<uint8_t> data, std::function<void()> on_finished);
+  void Stop();
+  void Pause();
+  void Resume();
+  void SetVolume(float volume);
+
+  // Captured output is handed out through ReadFrame instead of the device.
+  void SetCaptured(bool captured);
+  bool is_captured() const { return captured_; }
+
+  // Fills `out` with kFrameSamples * kChannels interleaved samples. Returns
+  // false when there is nothing to play (idle, paused or still buffering).
+  bool ReadFrame(float* out);
+
+ private:
+  struct Track {
+    std::vector<uint8_t> data;
+    std::function<void()> on_finished;
+  };
+
+  void ThreadMain();
+  void Decode(const Track& track, uint64_t generation);
+  bool Cancelled(uint64_t generation) const { return generation_ != generation; }
+  SDL_AudioStream* Sink();
+
+  std::thread thread_;
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  std::unique_ptr<Track> pending_;
+  std::atomic<uint64_t> generation_{0};
+  std::atomic<bool> quit_{false};
+  std::atomic<bool> paused_{false};
+  std::atomic<bool> captured_{false};
+  std::atomic<float> volume_{1.0f};
+
+  SDL_AudioStream* capture_stream_ = nullptr;  // resampler feeding ReadFrame
+  SDL_AudioStream* device_stream_ = nullptr;   // direct playback
+};
+
+}  // namespace rex::audio
