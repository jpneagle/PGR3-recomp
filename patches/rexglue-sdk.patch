diff --git a/src/audio/media_player.cpp b/src/audio/media_player.cpp
new file mode 100644
index 0000000..f440261
--- /dev/null
+++ b/src/audio/media_player.cpp
@@ -0,0 +1,345 @@
+/**
+ * @file        audio/media_player.cpp
+ * @brief       WMA/MP3 playback for the XMP (Xbox Music Player) title playlists
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the root for more details.
+ */
+
+#include <rex/audio/media_player.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+
+#include <SDL3/SDL.h>
+
+#include <rex/logging.h>
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+}
+
+namespace rex::audio {
+
+namespace {
+
+constexpr int kFrameBytes =
+    MediaPlayer::kFrameSamples * MediaPlayer::kChannels * int(sizeof(float));
+// Decode ahead by about a quarter of a second.
+constexpr int kBufferedBytes = MediaPlayer::kSampleRate / 4 * MediaPlayer::kChannels * 4;
+
+struct MemoryReader {
+  const uint8_t* data;
+  int64_t size;
+  int64_t pos;
+};
+
+int ReadPacket(void* opaque, uint8_t* buf, int buf_size) {
+  auto* r = static_cast<MemoryReader*>(opaque);
+  int64_t n = std::min<int64_t>(buf_size, r->size - r->pos);
+  if (n <= 0) {
+    return AVERROR_EOF;
+  }
+  std::memcpy(buf, r->data + r->pos, size_t(n));
+  r->pos += n;
+  return int(n);
+}
+
+int64_t Seek(void* opaque, int64_t offset, int whence) {
+  auto* r = static_cast<MemoryReader*>(opaque);
+  switch (whence & ~AVSEEK_FORCE) {
+    case AVSEEK_SIZE:
+      return r->size;
+    case SEEK_SET:
+      r->pos = offset;
+      break;
+    case SEEK_CUR:
+      r->pos += offset;
+      break;
+    case SEEK_END:
+      r->pos = r->size + offset;
+      break;
+    default:
+      return -1;
+  }
+  r->pos = std::clamp<int64_t>(r->pos, 0, r->size);
+  return r->pos;
+}
+
+// Any decoder sample layout -> interleaved stereo float.
+void ToStereoFloat(const AVFrame* frame, std::vector<float>& out) {
+  int n = frame->nb_samples, ch = frame->channels;
+  out.resize(size_t(n) * 2);
+  auto sample = [&](int c, int i) -> float {
+    switch (frame->format) {
+      case AV_SAMPLE_FMT_FLTP:
+        return reinterpret_cast<const float*>(frame->extended_data[c])[i];
+      case AV_SAMPLE_FMT_FLT:
+        return reinterpret_cast<const float*>(frame->extended_data[0])[i * ch + c];
+      case AV_SAMPLE_FMT_S16P:
+        return reinterpret_cast<const int16_t*>(frame->extended_data[c])[i] / 32768.0f;
+      case AV_SAMPLE_FMT_S16:
+        return reinterpret_cast<const int16_t*>(frame->extended_data[0])[i * ch + c] / 32768.0f;
+      default:
+        return 0.0f;
+    }
+  };
+  for (int i = 0; i < n; ++i) {
+    out[size_t(i) * 2] = sample(0, i);
+    out[size_t(i) * 2 + 1] = sample(ch > 1 ? 1 : 0, i);
+  }
+}
+
+}  // namespace
+
+MediaPlayer::MediaPlayer() {
+  if (!SDL_InitSubSystem(SDL_INIT_AUDIO)) {
+    REXAPU_ERROR("MediaPlayer: SDL_InitSubSystem(SDL_INIT_AUDIO) failed: {}", SDL_GetError());
+  }
+  SDL_AudioSpec spec = {SDL_AUDIO_F32, int(kChannels), int(kSampleRate)};
+  capture_stream_ = SDL_CreateAudioStream(&spec, &spec);
+  thread_ = std::thread([this] { ThreadMain(); });
+}
+
+MediaPlayer::~MediaPlayer() {
+  quit_ = true;
+  ++generation_;
+  cv_.notify_all();
+  if (thread_.joinable()) {
+    thread_.join();
+  }
+  if (device_stream_) {
+    SDL_DestroyAudioStream(device_stream_);
+  }
+  if (capture_stream_) {
+    SDL_DestroyAudioStream(capture_stream_);
+  }
+  SDL_QuitSubSystem(SDL_INIT_AUDIO);
+}
+
+void MediaPlayer::Play(std::vector<uint8_t> data, std::function<void()> on_finished) {
+  {
+    std::lock_guard lock(mutex_);
+    pending_ = std::make_unique<Track>(Track{std::move(data), std::move(on_finished)});
+    ++generation_;
+    paused_ = false;
+  }
+  cv_.notify_all();
+}
+
+void MediaPlayer::Stop() {
+  std::lock_guard lock(mutex_);
+  pending_.reset();
+  ++generation_;
+  if (capture_stream_) {
+    SDL_ClearAudioStream(capture_stream_);
+  }
+  if (device_stream_) {
+    SDL_ClearAudioStream(device_stream_);
+  }
+}
+
+void MediaPlayer::Pause() {
+  paused_ = true;
+  if (device_stream_) {
+    SDL_PauseAudioStreamDevice(device_stream_);
+  }
+}
+
+void MediaPlayer::Resume() {
+  paused_ = false;
+  if (device_stream_) {
+    SDL_ResumeAudioStreamDevice(device_stream_);
+  }
+}
+
+void MediaPlayer::SetVolume(float volume) {
+  volume_ = volume;
+  if (device_stream_) {
+    SDL_SetAudioStreamGain(device_stream_, volume);
+  }
+}
+
+void MediaPlayer::SetCaptured(bool captured) {
+  captured_ = captured;
+  if (captured && device_stream_) {
+    SDL_ClearAudioStream(device_stream_);
+  }
+}
+
+bool MediaPlayer::ReadFrame(float* out) {
+  if (!captured_ || paused_ || !capture_stream_ ||
+      SDL_GetAudioStreamAvailable(capture_stream_) < kFrameBytes) {
+    return false;
+  }
+  return SDL_GetAudioStreamData(capture_stream_, out, kFrameBytes) == kFrameBytes;
+}
+
+SDL_AudioStream* MediaPlayer::Sink() {
+  if (captured_) {
+    return capture_stream_;
+  }
+  if (!device_stream_) {
+    SDL_AudioSpec spec = {SDL_AUDIO_F32, int(kChannels), int(kSampleRate)};
+    device_stream_ =
+        SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, nullptr, nullptr);
+    if (!device_stream_) {
+      REXAPU_ERROR("MediaPlayer: SDL_OpenAudioDeviceStream failed: {}", SDL_GetError());
+      return nullptr;
+    }
+    SDL_SetAudioStreamGain(device_stream_, volume_);
+    if (!paused_) {
+      SDL_ResumeAudioStreamDevice(device_stream_);
+    }
+  }
+  return device_stream_;
+}
+
+void MediaPlayer::ThreadMain() {
+  while (!quit_) {
+    std::unique_ptr<Track> track;
+    uint64_t generation;
+    {
+      std::unique_lock lock(mutex_);
+      cv_.wait(lock, [this] { return quit_ || pending_; });
+      if (quit_) {
+        break;
+      }
+      track = std::move(pending_);
+      generation = generation_;
+      if (capture_stream_) {
+        SDL_ClearAudioStream(capture_stream_);
+      }
+      if (device_stream_) {
+        SDL_ClearAudioStream(device_stream_);
+      }
+    }
+    Decode(*track, generation);
+    if (!Cancelled(generation) && track->on_finished) {
+      track->on_finished();
+    }
+  }
+}
+
+void MediaPlayer::Decode(const Track& track, uint64_t generation) {
+  MemoryReader reader{track.data.data(), int64_t(track.data.size()), 0};
+  constexpr int kIoBufferSize = 32 * 1024;
+  auto* io_buffer = static_cast<uint8_t*>(av_malloc(kIoBufferSize));
+  AVIOContext* io =
+      avio_alloc_context(io_buffer, kIoBufferSize, 0, &reader, ReadPacket, nullptr, Seek);
+  AVFormatContext* format = avformat_alloc_context();
+  format->pb = io;
+  AVCodecContext* codec_ctx = nullptr;
+  AVPacket* packet = av_packet_alloc();
+  AVFrame* frame = av_frame_alloc();
+  std::vector<float> samples;
+  int stream_index = -1;
+  bool opened = false;
+  auto sleep = [] { std::this_thread::sleep_for(std::chrono::milliseconds(5)); };
+
+  do {
+    if (avformat_open_input(&format, nullptr, nullptr, nullptr) < 0) {
+      REXAPU_ERROR("MediaPlayer: unrecognized media file ({} bytes)", track.data.size());
+      break;
+    }
+    if (avformat_find_stream_info(format, nullptr) < 0) {
+      REXAPU_ERROR("MediaPlayer: no stream info");
+      break;
+    }
+    for (unsigned i = 0; i < format->nb_streams; ++i) {
+      if (format->streams[i]->codecpar->codec_type == AVMEDIA_TYPE_AUDIO) {
+        stream_index = int(i);
+        break;
+      }
+    }
+    if (stream_index < 0) {
+      REXAPU_ERROR("MediaPlayer: no audio stream");
+      break;
+    }
+    const AVCodecParameters* par = format->streams[stream_index]->codecpar;
+    const AVCodec* codec = avcodec_find_decoder(par->codec_id);
+    if (!codec) {
+      REXAPU_ERROR("MediaPlayer: no decoder for codec id {}", int(par->codec_id));
+      break;
+    }
+    codec_ctx = avcodec_alloc_context3(codec);
+    avcodec_parameters_to_context(codec_ctx, par);
+    if (avcodec_open2(codec_ctx, codec, nullptr) < 0) {
+      REXAPU_ERROR("MediaPlayer: failed to open decoder {}", codec->name);
+      break;
+    }
+    REXAPU_INFO("MediaPlayer: playing {} {} Hz {} ch", codec->name, par->sample_rate,
+                par->channels);
+    opened = true;
+
+    int input_rate = 0;
+    bool eof = false;
+    while (!eof && !Cancelled(generation)) {
+      SDL_AudioStream* sink = Sink();
+      if (!sink) {
+        break;
+      }
+      // Throttle: stay a little ahead of the consumer.
+      int buffered = sink == capture_stream_ ? SDL_GetAudioStreamAvailable(sink)
+                                             : SDL_GetAudioStreamQueued(sink);
+      if (buffered > kBufferedBytes) {
+        sleep();
+        continue;
+      }
+      if (av_read_frame(format, packet) < 0) {
+        eof = true;
+        avcodec_send_packet(codec_ctx, nullptr);
+      } else {
+        if (packet->stream_index == stream_index) {
+          avcodec_send_packet(codec_ctx, packet);
+        }
+        av_packet_unref(packet);
+      }
+      while (avcodec_receive_frame(codec_ctx, frame) == 0) {
+        if (frame->sample_rate != input_rate) {
+          input_rate = frame->sample_rate;
+          SDL_AudioSpec src = {SDL_AUDIO_F32, int(kChannels), input_rate};
+          SDL_SetAudioStreamFormat(sink, &src, nullptr);
+        }
+        ToStereoFloat(frame, samples);
+        SDL_PutAudioStreamData(sink, samples.data(), int(samples.size() * sizeof(float)));
+        av_frame_unref(frame);
+      }
+    }
+
+    // Let what is buffered play out before reporting the end of the song.
+    if (!Cancelled(generation)) {
+      SDL_AudioStream* sink = Sink();
+      if (sink) {
+        SDL_FlushAudioStream(sink);
+        while (!Cancelled(generation) && !quit_) {
+          int left = sink == capture_stream_ ? SDL_GetAudioStreamAvailable(sink)
+                                             : SDL_GetAudioStreamQueued(sink);
+          if (left < kFrameBytes) {
+            break;
+          }
+          sleep();
+        }
+      }
+    }
+  } while (false);
+  if (!opened) {
+    // Keep a playlist of undecodable files from spinning.
+    std::this_thread::sleep_for(std::chrono::milliseconds(200));
+  }
+
+  av_frame_free(&frame);
+  av_packet_free(&packet);
+  if (codec_ctx) {
+    avcodec_free_context(&codec_ctx);
+  }
+  avformat_close_input(&format);
+  if (io) {
+    av_freep(&io->buffer);
+    avio_context_free(&io);
+  }
+}
