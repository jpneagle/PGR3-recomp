+        rex::be<uint32_t> context;
+        rex::be<uint32_t> title_render;
+      }* args = memory_->TranslateVirtual<decltype(args)>(buffer_ptr);
+      static_assert_size(decltype(*args), 16);
+      REXKRNL_DEBUG("XMPCaptureOutput({:08X}, {:08X}, {:08X})", uint32_t(args->callback),
+                    uint32_t(args->context), uint32_t(args->title_render));
+      if (auto* audio_system = GetAudioSystem(kernel_state_)) {
+        audio_system->SetMusicCapture(args->callback, args->context);
+      }
+      return X_E_SUCCESS;
     }
